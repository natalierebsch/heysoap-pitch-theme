{%- capture children -%}
  {% content_for 'blocks' %}
{%- endcapture -%}

<div
  class="product-column-group spacing-style"
  style="
    --product-column-count: {{ block.settings.columns }};
    --product-column-count-mobile: {{ block.settings.columns_mobile }};
    --product-column-gap: {{ block.settings.gap }}px;
    --product-column-alignment: {{ block.settings.vertical_alignment }};
    {% render 'spacing-style', settings: block.settings %}
  "
  {{ block.shopify_attributes }}
>
  {{ children }}
</div>

{% stylesheet %}
  .product-column-group {
    display: grid;
    grid-template-columns: repeat(var(--product-column-count), minmax(0, 1fr));
    gap: var(--product-column-gap);
    align-items: var(--product-column-alignment);
    width: 100%;
  }

  .product-column-group > * {
    min-width: 0;
  }

  @media screen and (max-width: 749px) {
    .product-column-group {
      grid-template-columns: repeat(var(--product-column-count-mobile), minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Produkt-Spaltengruppe",
  "tag": null,
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Spalten"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Spalten am Desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Spalten mobil",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Abstand",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertikale Ausrichtung",
      "options": [
        {
          "value": "start",
          "label": "Oben"
        },
        {
          "value": "center",
          "label": "Mittig"
        },
        {
          "value": "end",
          "label": "Unten"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Innenabstand"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Oben",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Unten",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Links",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Rechts",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Preis und Menge",
      "category": "Produkt",
      "blocks": {
        "price": {
          "type": "price",
          "settings": {
            "width": "100%",
            "alignment": "left"
          }
        },
        "quantity": {
          "type": "quantity"
        }
      },
      "block_order": [
        "price",
        "quantity"
      ]
    }
  ]
}
{% endschema %}
