

{%- if block.settings.input_style == 'custom' -%}
  {%- capture wrapper_class -%}quantity-selector-wrapper--block-{{ block.id }}{%- endcapture -%}
  {% style %}
    .{{ wrapper_class }} {
      {%- render 'input-custom-styles', block_settings: block.settings -%}
      --style-border-width-inputs: {{ block.settings.border_width }}px;
      --style-border-radius-inputs: {{ block.settings.border_radius }}px;
      --style-border-radius-buttons-primary: {{ block.settings.border_radius }}px;
      --style-border-radius-buttons-secondary: {{ block.settings.border_radius }}px;
    }
  {% endstyle %}
{%- endif -%}

<div
  class="quantity-block quantity-block--{{ block.id }} size-style"
  style="{% render 'size-style', settings: block.settings %}"
>
  {% render 'quantity-selector', product: closest.product, block: block, wrapper_class: wrapper_class %}
</div>

{% stylesheet %}
  .quantity-block {
    max-width: 100%;
  }

  .quantity-block .quantity-selector-wrapper,
  .quantity-block .quantity-selector {
    width: 100%;
    max-width: 100%;
  }

  .quantity-block .quantity-selector {
    --quantity-selector-width: 100%;
    flex-basis: 100%;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.quantity",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Breite"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Breite am Desktop",
      "options": [
        {
          "value": "fit-content",
          "label": "An Inhalt anpassen"
        },
        {
          "value": "fill",
          "label": "Ausfüllen"
        },
        {
          "value": "custom",
          "label": "Benutzerdefiniert"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Benutzerdefinierte Breite",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "Breite mobil",
      "options": [
        {
          "value": "fit-content",
          "label": "An Inhalt anpassen"
        },
        {
          "value": "fill",
          "label": "Ausfüllen"
        },
        {
          "value": "custom",
          "label": "Benutzerdefiniert"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "Benutzerdefinierte Breite",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:content.input"
    },
    {
      "type": "select",
      "id": "input_style",
      "label": "t:settings.style",
      "options": [
        {
          "value": "default",
          "label": "t:options.default"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "default",
      "info": "t:info.edit_input_field_in_theme_settings"
    },
    {
      "type": "color",
      "id": "input_background_color",
      "label": "t:settings.background",
      "default": "{{ settings.color_palette.background }}",
      "visible_if": "{{ block.settings.input_style == \"custom\" }}"
    },
    {
      "type": "color",
      "id": "input_text_color",
      "label": "t:settings.text",
      "default": "{{ settings.color_palette.foreground }}",
      "visible_if": "{{ block.settings.input_style == \"custom\" }}"
    },
    {
      "type": "color",
      "id": "input_border_color",
      "label": "t:settings.borders",
      "default": "{{ settings.color_palette.foreground }}",
      "visible_if": "{{ block.settings.input_style == \"custom\" }}"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "t:settings.border_width",
      "min": 0,
      "max": 4,
      "step": 0.5,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.input_style == \"custom\" }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.input_style == \"custom\" }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.quantity",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
