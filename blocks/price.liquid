

{%- liquid
  assign block_settings = block.settings
  assign product_resource = closest.product
  assign selected_variant = product_resource.selected_or_first_available_variant
  assign show_discount_badge = false
  assign discount_percentage = 0
  if selected_variant.compare_at_price > selected_variant.price and selected_variant.compare_at_price > 0
    assign show_discount_badge = true
    assign discount_amount = selected_variant.compare_at_price | minus: selected_variant.price
    assign discount_percentage = discount_amount | times: 100.0 | divided_by: selected_variant.compare_at_price | round
  endif
-%}

{% liquid
  if block_settings.type_preset == 'rte' or block_settings.type_preset == 'paragraph'
    assign is_rte = true
  endif

  capture text_block_classes
    if block_settings.width == '100%'
      echo 'text-block--align-' | append: block_settings.alignment
      if block_settings.max_width == 'none'
        echo ' text-block--full-width'
      endif
    endif
    if block_settings.type_preset == 'custom'
      echo ' custom-typography'
      if block_settings.font_size != ''
        echo ' custom-font-size'
      endif
      if block_settings.color != ''
        echo ' custom-color'
      endif
    endif
    if block_settings.background
      echo ' text-block--background'
    endif
    if is_rte
      echo ' rte'
    endif
  endcapture
%}

<product-price
  class="price-block--{{ block.id }} price-block--compare-{{ block_settings.compare_price_position }} text-block {{ text_block_classes }} text-{{ block_settings.alignment }} {{ block_settings.type_preset | default: 'paragraph' }} spacing-style"
  data-block-id="{{ block.id }}"
  data-product-id="{{ product_resource.id }}"
  style="
    {% render 'typography-style', settings: block_settings %}
    {% render 'spacing-style', settings: block_settings %}
    {% if block_settings.text_color != blank %}
      --color: {{ block_settings.text_color }};
      --color-rgb: {{ block_settings.text_color.rgb }};
    {% endif %}
    --width: {{ block_settings.width }};
    --price-sale-color: {{ block_settings.sale_price_color | default: 'currentColor' }};
    --price-compare-color: {{ block_settings.compare_price_color | default: 'currentColor' }};
    --price-badge-background: {{ block_settings.badge_background_color }};
    --price-badge-color: {{ block_settings.badge_text_color }};
    --price-badge-radius: {{ block_settings.badge_border_radius }}px;
    --price-row-gap: {{ block_settings.price_gap }}px;
    --current-price-font: {{ block_settings.current_price_font }};
    --current-price-size: {{ block_settings.current_price_size }}px;
    --current-price-weight: {{ block_settings.current_price_weight }};
    --compare-price-font: {{ block_settings.compare_price_font }};
    --compare-price-size: {{ block_settings.compare_price_size }}px;
    --compare-price-weight: {{ block_settings.compare_price_weight }};
    --unit-price-font: {{ block_settings.unit_price_font }};
    --unit-price-size: {{ block_settings.unit_price_size }}px;
    --unit-price-weight: {{ block_settings.unit_price_weight }};
  "
  {{ block.shopify_attributes }}
>
  <div class="price-block__row">
    {% render 'price',
      show_unit_price: block_settings.show_unit_price,
      product_resource: product_resource,
      show_sale_price_first: block_settings.show_sale_price_first
    %}

    {% if block_settings.show_discount_badge and show_discount_badge %}
      <span class="price-block__discount-badge">
        {% case block_settings.discount_badge_content %}
          {% when 'sale' %}
            Sale
          {% when 'custom' %}
            {{ block_settings.discount_badge_text | escape }}
          {% else %}
            -{{ discount_percentage }}%
        {% endcase %}
      </span>
    {% endif %}
  </div>

  {% if block_settings.show_tax_info %}
    <div class="tax-note">
      {%- if cart.duties_included and cart.taxes_included -%}
        {{ 'content.duties_and_taxes_included' | t }}
      {%- elsif cart.taxes_included -%}
        {{ 'content.taxes_included' | t }}
      {%- elsif cart.duties_included -%}
        {{ 'content.duties_included' | t }}
      {%- endif -%}

      {%- if shop.shipping_policy.body != blank -%}
        {{ 'content.shipping_policy' | t }}
      {%- endif -%}
    </div>
  {% endif %}

  {%- if selected_variant != blank and block_settings.show_installments -%}
    <div class="installments">
      {%- assign product_form_installment_id = 'product-form-installment-' | append: block.id -%}
      {%- form 'product', product_resource, id: product_form_installment_id, class: 'payment-terms' -%}
        <input
          type="hidden"
          name="id"
          value="{{ selected_variant.id }}"
        >
        {{ form | payment_terms }}
      {%- endform -%}
    </div>
  {%- endif -%}
</product-price>

{% render 'payment-terms-styles' %}

{% stylesheet %}
  .price-block__row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--price-row-gap);
  }

  product-price.text-center .price-block__row {
    justify-content: center;
  }

  product-price.text-right .price-block__row {
    justify-content: flex-end;
  }

  .price-block__row [ref='priceContainer'] {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--price-row-gap);
  }

  .price-block__row .price {
    color: var(--price-sale-color);
    font-family: var(--current-price-font);
    font-size: var(--current-price-size);
    font-weight: var(--current-price-weight);
  }

  .price-block__row .compare-at-price {
    color: var(--price-compare-color);
    opacity: 0.7;
    font-family: var(--compare-price-font);
    font-size: var(--compare-price-size);
    font-weight: var(--compare-price-weight);
  }

  .price-block__row .unit-price {
    width: 100%;
    order: 2;
    font-family: var(--unit-price-font);
    font-size: var(--unit-price-size);
    font-weight: var(--unit-price-weight);
  }

  .price-block--compare-left .compare-at-price {
    order: -1;
  }

  .price-block--compare-right .compare-at-price {
    order: 1;
  }

  :is(.price-block--compare-top, .price-block--compare-bottom) .price-block__row [ref='priceContainer'] {
    flex-direction: column;
    gap: var(--price-row-gap);
  }

  .price-block--compare-top .compare-at-price {
    order: -1;
  }

  .price-block--compare-bottom .compare-at-price {
    order: 1;
  }

  :is(.price-block--compare-top, .price-block--compare-bottom).text-center
    .price-block__row
    [ref='priceContainer'] {
    align-items: center;
  }

  :is(.price-block--compare-top, .price-block--compare-bottom).text-right
    .price-block__row
    [ref='priceContainer'] {
    align-items: flex-end;
  }

  .price-block__discount-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.25em 0.55em;
    border-radius: var(--price-badge-radius);
    background: var(--price-badge-background);
    color: var(--price-badge-color);
    font-size: 0.7em;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
  }
{% endstylesheet %}

